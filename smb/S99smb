#!/bin/sh
# SMB share of the KVM's ISO storage (/userdata/media) via ksmbd.
# Installed as /etc/init.d/S99smb, started from a firmware init script
# (see install-smb.sh -- rcS globs before the overlay is mounted).
#
# Guests get read-only access without a password; the user "admin"
# (see set-smb-password.sh) may write.  A small index.html in the share
# links to the web GUI so the share is a landing page too.
#
# Caveat: kvmd's "virtual drive" mode umounts /userdata/media to hand the
# whole partition to the target PC.  A connected SMB client keeps the mount
# busy, so disconnect clients first (or `S99smb stop`).

DIR=/userdata/smb
MEDIA=/userdata/media
CONF=/var/run/ksmbd.conf
USERS=$DIR/ksmbdpwd.db
PIDDIR=/var/run/smb-bonjour
MOUNTD=$DIR/ksmbd.mountd
CONTROL=$DIR/ksmbd.control
VENDOR_MDNS_PID=/var/run/mDNSResponder-system.pid
WSDD=$DIR/wsdd.py
LLMNRD=$DIR/llmnrd.py

log() { echo "smb: $*" >> /var/log/smb.log; }

load_modules() {
    lsmod | grep -q '^ksmbd ' && return 0
    kver=$(uname -r)
    for m in cifs_arc4 cifs_md4 ksmbd; do
        f="$DIR/$m.ko"
        [ -f "$f" ] || { log "missing $f"; return 1; }
        if ! strings "$f" | grep -q "^vermagic=$kver "; then
            log "$m.ko was built for another kernel (need $kver) -- not loading"
            return 1
        fi
    done
    insmod "$DIR/cifs_arc4.ko" 2>/dev/null
    insmod "$DIR/cifs_md4.ko" 2>/dev/null
    insmod "$DIR/ksmbd.ko" || { log "insmod ksmbd failed"; return 1; }
}

# Two settings here exist for the Windows client, see docs/smb.md:
#   map to guest = never   -- an unknown user is refused instead of silently
#                             mapped to guest.  Windows sends its logged-on
#                             user first; a refusal makes the Explorer show a
#                             credential prompt, a silent guest mapping makes
#                             it fail with "cannot access" (since 24H2 a guest
#                             session cannot satisfy the signing requirement).
#                             Guests log in as the user "guest" (empty
#                             password), created by install-smb.sh.
#   smb3 encryption = disabled -- ksmbd 6.1 generates encryption keys for a
#                             guest session too and lets ENCRYPT_DATA clobber
#                             IS_GUEST in the session flags.
gen_conf() {
    host=$(hostname)
    cat > "$CONF" <<CONF
[global]
	netbios name = $host
	server string = $host (GL KVM storage)
	workgroup = WORKGROUP
	map to guest = never
	guest account = nobody
	server min protocol = SMB2_10
	server max protocol = SMB3_11
	ipc timeout = 20
	smb2 max read = 4MB
	smb2 max write = 4MB
	restrict anonymous = 0
	smb3 encryption = disabled

[media]
	comment = ISO images and files for the virtual drive
	path = $MEDIA
	browseable = yes
	guest ok = yes
	read only = yes
	write list = admin
	force user = root
	force group = root
	create mask = 0644
	directory mask = 0755
	veto files = /.DS_Store/._*/.Spotlight-V100/.fseventsd/.Trashes/
CONF
}

gen_index() {
    host=$(hostname)
    ip=$(ip -4 -o addr show dev eth0 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | head -1)
    model=$(grep RK_MODEL /etc/version 2>/dev/null | cut -d= -f2 | tr -d ' ')
    [ -w "$MEDIA" ] || return
    cat > "$MEDIA/index.html" <<HTML
<!doctype html>
<meta charset="utf-8">
<meta http-equiv="refresh" content="3;url=https://$host.local/">
<title>$host</title>
<style>body{font:16px/1.5 -apple-system,Segoe UI,sans-serif;max-width:40em;margin:4em auto;padding:0 1em;color:#222}a{color:#0a66c2}code{background:#f3f3f3;padding:2px 5px;border-radius:3px}</style>
<h1>$host</h1>
<p>GL KVM ${model:+($model)} &mdash; ISO storage share.</p>
<p>Web GUI: <a href="https://$host.local/">https://$host.local/</a></p>
${ip:+<p>Fallback by address: <a href="http://$ip/">http://$ip/</a> <small>(as of last boot, may change with DHCP)</small></p>}
<p>Guests may read this share. To copy ISOs here connect as user <code>admin</code>.</p>
<p><small>Redirecting to the web GUI in 3 seconds&hellip;</small></p>
HTML
}

# The firmware runs a second mDNS daemon purely to publish <hostname>.local:
#
#     mDNSResponder -b -n <hostname> -P /var/run/mDNSResponder-system.pid
#
# That binary is Apple's mDNSResponderPosix, and its service type defaults to
# _afpovertcp._tcp when -t is not given.  So every GL KVM advertises an AFP
# server on port 548 that does not exist.  The Finder prefers AFP over SMB for
# a host offering both, connects to 548, gets nothing, and reports "Connection
# Failed" -- without ever trying port 445.  Nothing reaches ksmbd, which is why
# its log stays empty while mount_smbfs and smbutil, which speak SMB directly,
# work fine.
#
# So rather than registering _smb._tcp alongside it, restart that instance with
# an explicit -t: <hostname>.local keeps resolving and the bogus AFP record is
# replaced by the share we actually serve.

find_vendor_mdns() {  # echoes "<pid> <name>" of a vendor instance lacking -t
    for p in $(pgrep mDNSResponder 2>/dev/null); do
        args=$(tr '\0' ' ' < "/proc/$p/cmdline" 2>/dev/null)
        case "$args" in
            *" -t "*)  continue ;;
            *" -n "*)  ;;
            *)         continue ;;
        esac
        rest=${args#* -n }
        echo "$p ${rest%% *}"
        return 0
    done
    return 1
}

vendor_mdns_fixed() {  # true if a vendor instance already carries -t _smb._tcp
    for p in $(pgrep mDNSResponder 2>/dev/null); do
        case "$(tr '\0' ' ' < "/proc/$p/cmdline" 2>/dev/null)" in
            *" -t _smb._tcp "*) return 0 ;;
        esac
    done
    return 1
}

bonjour() {
    mkdir -p "$PIDDIR"
    host=$(hostname)

    # Already done on an earlier start: registering again would announce the
    # share twice and the Finder would show "<host> (2)".
    vendor_mdns_fixed && return

    if found=$(find_vendor_mdns); then
        pid=${found%% *}
        name=${found#* }
        [ -n "$name" ] || name=$host
        echo "$name" > "$PIDDIR/vendor-mdns-name"
        kill "$pid" 2>/dev/null
        sleep 1
        rm -f "$VENDOR_MDNS_PID"
        /usr/bin/mDNSResponder -b -n "$name" -t _smb._tcp -p 445 \
            -P "$VENDOR_MDNS_PID" >/dev/null 2>&1
        log "vendor mDNS re-registered as _smb._tcp (default would be AFP)"
        return
    fi

    # No vendor instance to correct: announce the share ourselves.
    command -v dns-sd >/dev/null 2>&1 || return
    pgrep -f "dns-sd -R $host _smb" >/dev/null 2>&1 && return
    dns-sd -R "$host" _smb._tcp local 445 >/dev/null 2>&1 &
    echo $! > "$PIDDIR/smb.pid"
}

restore_vendor_mdns() {
    [ -f "$PIDDIR/vendor-mdns-name" ] || return
    name=$(cat "$PIDDIR/vendor-mdns-name")
    for p in $(pgrep mDNSResponder 2>/dev/null); do
        args=$(tr '\0' ' ' < "/proc/$p/cmdline" 2>/dev/null)
        case "$args" in *" -t _smb._tcp "*) kill "$p" 2>/dev/null ;; esac
    done
    sleep 1
    rm -f "$VENDOR_MDNS_PID"
    # Back to the firmware's own invocation, AFP default and all.
    /usr/bin/mDNSResponder -b -n "$name" -P "$VENDOR_MDNS_PID" >/dev/null 2>&1
}

# ---------------------------------------------------------------- watchers
#
# index.html carries the current address as a fallback next to the stable
# <hostname>.local link, so it goes stale when DHCP hands out a new lease.
# connmand is the DHCP client here and has no dispatcher scripts, and the
# udhcpc hook directories on the box are unused -- so watch the kernel's
# address events directly.  `ip monitor` blocks until something happens; if
# it is missing, fall back to a slow poll.

watch_address() {
    pgrep -f "$DIR/.smb-ipwatch" >/dev/null 2>&1 && return
    cat > "$DIR/.smb-ipwatch" <<'WATCH'
#!/bin/sh
# Regenerate the share's index.html whenever this host's IPv4 address changes.
# Started by /etc/init.d/S99smb; not meant to be run by hand.
# Compare the whole address list, not just the first one: a lease change can
# add or drop an address without the first entry moving.
addrs() { ip -4 -o addr show dev eth0 2>/dev/null | awk '{print $4}' | sort | tr '\n' ' '; }
cur=$(addrs)
refresh() {
    new=$(addrs)
    [ "$new" = "$cur" ] && return
    cur=$new
    /etc/init.d/S99smb reload >/dev/null 2>&1
    echo "smb: addresses now ${new:-none}-- index.html rewritten" >> /var/log/smb.log
}
# ip monitor blocks and prints a line per address event.  If it is not
# available it returns at once and we fall through to polling.
ip monitor address 2>/dev/null | while read -r _event; do
    refresh
done
while :; do
    sleep 60
    refresh
done
WATCH
    chmod 755 "$DIR/.smb-ipwatch"
    setsid "$DIR/.smb-ipwatch" >/dev/null 2>&1 &
    echo $! > "$PIDDIR/ipwatch.pid"
}

# Windows lists SMB hosts under "Computer" from WSD (Web Services Discovery),
# not from the SSDP responder that puts the KVM under "Other Devices" -- that
# one only carries the presentationURL, which is why a click there opens the
# web GUI.  wsdd.py answers WSD probes so the share shows up as a computer.
# Optional: if the file is not installed, everything else still works.
#
# Note for Windows 11: guest logons to SMB are refused by default
# (AllowInsecureGuestAuth), so a double-click asks for credentials unless the
# policy is changed -- use the admin account there.

start_wsdd() {
    [ -f "$WSDD" ] || return
    pgrep -f "$WSDD" >/dev/null 2>&1 && return
    command -v python3 >/dev/null 2>&1 || { log "no python3, skipping wsdd"; return; }
    iface=$(ip -4 -o route show default 2>/dev/null | awk '{print $5}' | head -1)
    [ -n "$iface" ] || iface=eth0
    setsid python3 "$WSDD" -i "$iface" -n "$(hostname)" -w WORKGROUP -p -4 \
        >> /var/log/wsdd.log 2>&1 &
    echo $! > "$PIDDIR/wsdd.pid"
    log "wsdd started on $iface"
}

# WSD only tells Windows the name.  To connect, Windows resolves a flat name
# through DNS, then LLMNR (UDP 5355), then NetBIOS -- never through mDNS
# unless the name ends in .local.  Without an LLMNR answer the Explorer lists
# the KVM and then fails with "Windows cannot access \\<name>".  llmnrd.py
# answers for this host's own name only.
start_llmnrd() {
    [ -f "$LLMNRD" ] || return
    pgrep -f "$LLMNRD" >/dev/null 2>&1 && return
    command -v python3 >/dev/null 2>&1 || return
    iface=$(ip -4 -o route show default 2>/dev/null | awk '{print $5}' | head -1)
    [ -n "$iface" ] || iface=eth0
    setsid python3 "$LLMNRD" "$iface" "$(hostname)" >> /var/log/llmnrd.log 2>&1 &
    echo $! > "$PIDDIR/llmnrd.pid"
    log "llmnrd started on $iface"
}

start() {
    # ksmbd-tools is one multi-call binary; make sure the names exist
    if [ -x "$DIR/ksmbd.tools" ]; then
        for t in mountd adduser control; do
            [ -e "$DIR/ksmbd.$t" ] || ln -s ksmbd.tools "$DIR/ksmbd.$t"
        done
    fi
    [ -x "$MOUNTD" ] || { log "$MOUNTD missing"; return 1; }

    # Each of these is idempotent, so a second "start" repairs whatever is
    # missing rather than bailing out because ksmbd happens to be up.
    if ! pgrep -f "$MOUNTD" >/dev/null; then
        load_modules || return 1
        gen_conf
        gen_index
        [ -f "$USERS" ] || touch "$USERS"
        # setsid: ksmbd.mountd daemonizes but stays in the caller's session,
        # so starting it over ssh would let it die with that session.
        setsid "$MOUNTD" -C "$CONF" -P "$USERS" || { log "ksmbd.mountd failed"; return 1; }
    fi
    bonjour
    watch_address
    start_wsdd
    start_llmnrd
    log "started"
}

stop() {
    restore_vendor_mdns
    pkill -f "$DIR/.smb-ipwatch" 2>/dev/null
    pkill -f "$WSDD" 2>/dev/null
    pkill -f "$LLMNRD" 2>/dev/null
    for p in "$PIDDIR"/*.pid; do
        [ -f "$p" ] && kill "$(cat "$p")" 2>/dev/null
    done
    rm -rf "$PIDDIR"
    if pgrep -f "$MOUNTD" >/dev/null; then
        "$CONTROL" -s >/dev/null 2>&1 || pkill -f "$MOUNTD" 2>/dev/null
        sleep 1
    fi
    rmmod ksmbd 2>/dev/null
    rmmod cifs_md4 2>/dev/null
    rmmod cifs_arc4 2>/dev/null
    log "stopped"
}

case "${1:-start}" in
  start)   start ;;
  stop)    stop ;;
  restart) stop; sleep 1; start ;;
  reload)  gen_conf; gen_index; [ -x "$CONTROL" ] && "$CONTROL" -r ;;
  status)
    if pgrep -f "$MOUNTD" >/dev/null; then echo "smb: running"; else echo "smb: stopped"; exit 1; fi ;;
esac
