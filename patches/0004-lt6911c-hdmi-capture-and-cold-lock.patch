+/* GLKVM-Streamer liest diese sysfs-Attribute (Vendor-Kontrakt). Ohne
+ * "resolution" bricht der Streamer endlos ab ("can't open resolution file")
+ * -> kein Bild, obwohl der Chip lockt. Format wie Vendor: "BxH@FPS". */
+static ssize_t resolution_show(struct device *dev,
+			       struct device_attribute *attr, char *buf)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct lt6911c_state *lt6911c = to_state(sd);
+	struct v4l2_bt_timings *bt = &lt6911c->timings.bt;
+
+	if (lt6911c->nosignal || !bt->width)
+		return sprintf(buf, "0x0@0\n");
+	return sprintf(buf, "%ux%u@%u\n", bt->width, bt->height, fps_calc(bt));
+}
+static DEVICE_ATTR_RO(resolution);
+
+static ssize_t real_resolution_show(struct device *dev,
+				    struct device_attribute *attr, char *buf)
+{
+	return resolution_show(dev, attr, buf);
+}
+static DEVICE_ATTR_RO(real_resolution);
+
