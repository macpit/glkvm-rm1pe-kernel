+/* kvmd (x_upgrade) erwartet: echo 1 > /sys/bus/i2c/devices/1-002b/reset */
+static ssize_t reset_store(struct device *dev, struct device_attribute *attr,
+			   const char *buf, size_t count)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct lt6911c_state *lt6911c = to_state(sd);
+
+	lt6911c_reset(lt6911c);
+	gpiod_set_value(lt6911c->hpd_ctl_gpio, 1);
+	schedule_delayed_work(&lt6911c->delayed_work_res_change, HZ / 2);
+	return count;
+}
+static DEVICE_ATTR_WO(reset);
